<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REST.MVVM.Views.UpdateView"
             Title=""
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <Label Text="&lt;"
                       FontSize="20"
                       VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryColor}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Back_Clicked" NumberOfTapsRequired="1"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Edit Session"
                       Grid.Column="1"
                       Style="{StaticResource HeaderTitle}"/>
            </Grid>

            <!-- Student -->
            <Label Text="Student Name" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Entry Text="{Binding CurrentSession.StudentName}" BackgroundColor="Transparent" TextColor="Black"/>
            </Frame>

            <!-- Counselor -->
            <Label Text="Counselor" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Entry Text="{Binding CurrentSession.CounselorName}" BackgroundColor="Transparent" TextColor="Black"/>
            </Frame>

            <!-- Date and Time -->
            <Label Text="Date" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <DatePicker TextColor="Black"/>
            </Frame>
            <Label Text="Time" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <TimePicker TextColor="Black"/>
            </Frame>
            
            <!-- Notes -->
            <Label Text="Notes" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Editor Text="{Binding CurrentSession.Notes}"
            HeightRequest="150"
            BackgroundColor="Transparent"
            TextColor="Black"/>
            </Frame>

            <!-- Update Button -->
            <Button Text="Update Session"
                    Command="{Binding UpdateCommand}"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,8,0,0"/>

            <!-- Danger Zone -->
            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,16,0,0"/>
            <Label Text="DANGER ZONE"
                   FontAttributes="Bold"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>
            <Button Text="Hard Delete"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#FFE5E5"
                    TextColor="Red"
                    CornerRadius="10"/>
            <Label Text="This action is permanent and cannot be undone."
                   FontSize="11"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>