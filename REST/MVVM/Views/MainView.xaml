<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REST.MVVM.Views.MainView"
             Title=""
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <Grid Padding="20,18,20,14"
              ColumnDefinitions="*,Auto"
              BackgroundColor="White">
            <Label Text="Counseling Sessions"
                   Style="{StaticResource HeaderTitle}"
                   VerticalOptions="Center"/>
            <Frame Grid.Column="1"
                   Padding="10,6"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource PrimaryColor}"
                   HasShadow="False"
                   HorizontalOptions="End"
                   VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="MC"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center"/>
                    <BoxView WidthRequest="1"
                             HeightRequest="14"
                             BackgroundColor="#44FFFFFF"
                             VerticalOptions="Center"/>
                    <Label Text="✕"
                           TextColor="#CCFFFFFF"
                           FontSize="13"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Closed_Click" NumberOfTapsRequired="1"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Frame>
            <!-- Bottom divider -->
            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="0.5"
                     BackgroundColor="{StaticResource HeaderDivider}"
                     VerticalOptions="End"/>
        </Grid>

        <!-- SEARCH -->
        <Frame Grid.Row="1"
               Margin="15,12,15,4"
               Padding="4,0"
               CornerRadius="10"
               BackgroundColor="White"
               BorderColor="{StaticResource DividerColor}"
               HasShadow="False">
            <SearchBar Placeholder="Search students or dates"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{StaticResource PlaceholderColor}"/>
        </Frame>

        <!-- LIST + FLOATING BUTTON -->
        <Grid Grid.Row="2">
            <CollectionView Margin="15,6,15,0"
                            ItemsSource="{Binding Sessions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource SessionCard}">
                            <Grid ColumnDefinitions="4,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  Padding="0">

                                <!-- Left accent bar -->
                                <BoxView Grid.RowSpan="3"
                                         BackgroundColor="{StaticResource PrimaryColor}"
                                         WidthRequest="4"
                                         CornerRadius="12,0,0,12"
                                         VerticalOptions="Fill"/>

                                <!-- Student name -->
                                <Label Text="{Binding StudentName}"
                                       Style="{StaticResource SessionName}"
                                       Grid.Row="0" Grid.Column="1"/>

                                <!-- Counselor name -->
                                <Label Text="{Binding CounselorName}"
                                       Style="{StaticResource SessionCounselor}"
                                       Grid.Row="1" Grid.Column="1"
                                       Grid.ColumnSpan="2"/>

                                <!-- Session date -->
                                <Label Text="{Binding SessionDate, StringFormat='{0:MMMM dd, yyyy}'}"
                                       Style="{StaticResource SessionDate}"
                                       Grid.Row="2" Grid.Column="1"
                                       Grid.ColumnSpan="2"/>

                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Update_Clicked"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FLOATING BUTTON -->
            <Button Text="+"
                    Style="{StaticResource FloatingButton}"
                    Clicked="Create_Clicked"
                    HorizontalOptions="End"
                    VerticalOptions="End"/>
        </Grid>

    </Grid>
</ContentPage>