<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REST.MVVM.Views.CreateView"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <Label Text="X"
                       FontSize="20"
                       VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryColor}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Close_Clicked" NumberOfTapsRequired="1"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="New Session"
                       Grid.Column="1"
                       Style="{StaticResource HeaderTitle}"/>
            </Grid>

            <!-- Student -->
            <Label Text="Student Name" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Entry Text="{Binding StudentName}"
                       Placeholder="Enter student name"
                       TextColor="Black"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Counselor -->
            <Label Text="Assigned Counselor" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Entry Text="{Binding CounselorName}"
                       Placeholder="Enter counselor name"
                       TextColor="Black"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Date -->
            <Label Text="Session Date" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10,0" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <DatePicker Date="{Binding SessionDate}"
                            TextColor="Black"/>
            </Frame>

            <!-- Notes -->
            <Label Text="Notes" FontAttributes="Bold" TextColor="Black"/>
            <Frame Padding="10" CornerRadius="8" HasShadow="False" BackgroundColor="White">
                <Editor Text="{Binding Notes}"
                        TextColor="Black"
                        Placeholder="Mention session objectives or initial observations..."
                        HeightRequest="120"
                        BackgroundColor="Transparent"/>
            </Frame>

            <!-- Buttons -->
            <Button Text="Save Session"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,8,0,0"/>
            <Button Text="Cancel"
                    BackgroundColor="#E0E0E0"
                    Clicked="Close_Clicked"
                    TextColor="#333333"
                    CornerRadius="10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>